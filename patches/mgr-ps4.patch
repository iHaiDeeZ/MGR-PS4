diff --git a/sdk/include/rex/ui/ps4_imgui_input.h b/sdk/include/rex/ui/ps4_imgui_input.h
new file mode 100644
index 0000000..243a1a6
--- /dev/null
+++ b/sdk/include/rex/ui/ps4_imgui_input.h
@@ -0,0 +1,142 @@
+/**
+ * @file        rex/ui/ps4_imgui_input.h
+ * @brief       The DualShock 4 for the SDK's ImGui menus on the PS4
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+#include <imgui.h>
+
+/*
+ * The menus with the DualShock 4
+ *
+ * The PS4 has no mouse or keyboard for the menus (the SDK's, and an app's own such as MGR's L3+R3 quick menu): the
+ * pad of the user who started the app drives them, as switch_imgui_input.h does on the Switch.
+ *
+ *  - window_ps4.cpp reads the pad (ReadUiEntry): libScePad's state through the handle the input driver opened
+ *    (scePadGetHandle), so the menus have it even while the game does not poll (loading screens).
+ *  - ImGuiDrawer::Draw applies it on the UI thread, right before ImGui::NewFrame.
+ *  - ReXApp gives the game a neutral pad while a menu window has navigation focus (GameReceivesGamepad).
+ *
+ * Buttons as in the PS4's own menus: Cross accepts, Circle goes back, Triangle edits a field, the D-pad moves, the left
+ * stick scrolls, L1/R1 change tabs. Square is not passed: held, it is ImGui's window selector, which takes the focus
+ * away from the menu. L3 and R3 are passed (nothing in ImGui uses them): an app's dialog reads them for its shortcut.
+ */
+namespace rex::ui::ps4 {
+
+// libScePad's button bits (ORBIS_PAD_BUTTON_* in orbis/_types/pad.h), copied so this header needs no OpenOrbis
+// include; window_ps4.cpp checks with static_assert that they match.
+inline constexpr uint32_t kButtonL3 = 0x00000002;
+inline constexpr uint32_t kButtonR3 = 0x00000004;
+inline constexpr uint32_t kButtonOptions = 0x00000008;
+inline constexpr uint32_t kButtonUp = 0x00000010;
+inline constexpr uint32_t kButtonRight = 0x00000020;
+inline constexpr uint32_t kButtonDown = 0x00000040;
+inline constexpr uint32_t kButtonLeft = 0x00000080;
+inline constexpr uint32_t kButtonL1 = 0x00000400;
+inline constexpr uint32_t kButtonR1 = 0x00000800;
+inline constexpr uint32_t kButtonTriangle = 0x00001000;
+inline constexpr uint32_t kButtonCircle = 0x00002000;
+inline constexpr uint32_t kButtonCross = 0x00004000;
+inline constexpr uint32_t kButtonSquare = 0x00008000;
+inline constexpr uint32_t kButtonTouchPad = 0x00100000;
+
+// What was read from the pad in one UI frame.
+struct UiEntry {
+  bool connected = false;
+  uint32_t buttons = 0;
+  // -32767..32767, up and right positive.
+  int32_t stick_left_x = 0;
+  int32_t stick_left_y = 0;
+  int32_t stick_right_x = 0;
+  int32_t stick_right_y = 0;
+  // 0..255.
+  uint8_t l2 = 0;
+  uint8_t r2 = 0;
+};
+
+// In window_ps4.cpp; UI thread only.
+void ReadUiEntry(UiEntry& output);
+
+inline void ConfigureNavigation(ImGuiIO& io) {
+  io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+  // ImGui reads the face buttons by position: the bottom one (Cross) accepts, the right one (Circle) goes back.
+  io.ConfigNavSwapGamepadButtons = false;
+}
+
+namespace detail {
+
+// One direction of a stick axis, 0..1, with a dead zone.
+inline float Sense(int32_t value, bool positive) {
+  constexpr float kMax = 32767.0f;
+  constexpr float kDeadZone = 0.25f;
+  float v = float(value) / kMax;
+  if (!positive) {
+    v = -v;
+  }
+  if (v <= kDeadZone) {
+    return 0.0f;
+  }
+  v = (v - kDeadZone) / (1.0f - kDeadZone);
+  return v > 1.0f ? 1.0f : v;
+}
+
+inline void Stick(ImGuiIO& io, ImGuiKey up, ImGuiKey down, ImGuiKey left, ImGuiKey right, int32_t x,
+                  int32_t y) {
+  const float u = Sense(y, true);
+  const float d = Sense(y, false);
+  const float l = Sense(x, false);
+  const float r = Sense(x, true);
+  io.AddKeyAnalogEvent(up, u > 0.0f, u);
+  io.AddKeyAnalogEvent(down, d > 0.0f, d);
+  io.AddKeyAnalogEvent(left, l > 0.0f, l);
+  io.AddKeyAnalogEvent(right, r > 0.0f, r);
+}
+
+}  // namespace detail
+
+// Translates a pad reading into ImGui events. ImGui discards events that repeat the previous state, so it can be
+// called every frame.
+inline void ApplyEntry(ImGuiIO& io, const UiEntry& e) {
+  if (e.connected) {
+    io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+  } else {
+    io.BackendFlags &= ~ImGuiBackendFlags_HasGamepad;
+  }
+  const uint32_t b = e.connected ? e.buttons : 0;
+  struct Button {
+    uint32_t bit;
+    ImGuiKey key;
+  };
+  static constexpr Button kButtons[] = {
+      {kButtonCross, ImGuiKey_GamepadFaceDown},  {kButtonCircle, ImGuiKey_GamepadFaceRight},
+      {kButtonTriangle, ImGuiKey_GamepadFaceUp}, {kButtonUp, ImGuiKey_GamepadDpadUp},
+      {kButtonDown, ImGuiKey_GamepadDpadDown},   {kButtonLeft, ImGuiKey_GamepadDpadLeft},
+      {kButtonRight, ImGuiKey_GamepadDpadRight}, {kButtonL1, ImGuiKey_GamepadL1},
+      {kButtonR1, ImGuiKey_GamepadR1},           {kButtonL3, ImGuiKey_GamepadL3},
+      {kButtonR3, ImGuiKey_GamepadR3},           {kButtonOptions, ImGuiKey_GamepadStart},
+      {kButtonTouchPad, ImGuiKey_GamepadBack},
+  };
+  for (const Button& button : kButtons) {
+    io.AddKeyEvent(button.key, (b & button.bit) != 0);
+  }
+  const float l2 = e.connected ? float(e.l2) / 255.0f : 0.0f;
+  const float r2 = e.connected ? float(e.r2) / 255.0f : 0.0f;
+  io.AddKeyAnalogEvent(ImGuiKey_GamepadL2, l2 > 0.1f, l2);
+  io.AddKeyAnalogEvent(ImGuiKey_GamepadR2, r2 > 0.1f, r2);
+  detail::Stick(io, ImGuiKey_GamepadLStickUp, ImGuiKey_GamepadLStickDown, ImGuiKey_GamepadLStickLeft,
+                ImGuiKey_GamepadLStickRight, e.connected ? e.stick_left_x : 0, e.connected ? e.stick_left_y : 0);
+  detail::Stick(io, ImGuiKey_GamepadRStickUp, ImGuiKey_GamepadRStickDown, ImGuiKey_GamepadRStickLeft,
+                ImGuiKey_GamepadRStickRight, e.connected ? e.stick_right_x : 0, e.connected ? e.stick_right_y : 0);
+}
+
+// The pad belongs to the menu, not the game, while a window has navigation focus. Windows that only show data (a
+// frame counter) carry NoNavInputs and do not take it.
+inline bool GameReceivesGamepad(const ImGuiIO& io) { return !io.WantCaptureMouse && !io.NavActive; }
+
+}  // namespace rex::ui::ps4
