diff --git a/sdk/cmake/rexglue_ps4.cmake b/sdk/cmake/rexglue_ps4.cmake
new file mode 100644
index 0000000..39b2bc8
--- /dev/null
+++ b/sdk/cmake/rexglue_ps4.cmake
@@ -0,0 +1,44 @@
+# PS4 (ps4-kit): how a title links into one eboot.
+#
+# Included by the SDK's CMakeLists.txt when REXGLUE_PLATFORM_PS4 is on. The project must have included ps4-kit.cmake
+# (ps4_kit_app, ps4_kit_link_mesa) and be configured with ps4-kit's toolchain: clang 21, libc++ 21, OpenOrbis, ld.lld
+# called directly (no -Wl,: CMake's LINKER: options reach ld.lld as plain arguments).
+
+include_guard(GLOBAL)
+
+# rexglue_ps4_configure_target(<target> [GPU_PLUGINS ...]): the PS4 entry point, ReXApp, and every object of the
+# runtime in the title. From an archive the linker would only pull members that resolve an undefined symbol, and
+# several do nothing but register themselves from a static constructor (cvars, kernel exports).
+function(rexglue_ps4_configure_target target_name)
+    cmake_parse_arguments(ARG "" "" "GPU_PLUGINS" ${ARGN})
+
+    target_sources(${target_name} PRIVATE
+        ${REXGLUE_SHARE_DIR}/windowed_app_main_ps4.cpp
+        ${REXGLUE_SHARE_DIR}/rex_app.cpp)
+    target_compile_definitions(${target_name} PRIVATE
+        REXGLUE_BUILD_CONFIG="$<CONFIG>")
+    target_compile_features(${target_name} PRIVATE cxx_std_23)
+
+    set(_whole "$<TARGET_FILE:rexruntime>")
+    set(_libs rexruntime)
+    foreach(_plugin IN LISTS ARG_GPU_PLUGINS)
+        if(NOT TARGET rexgpu-${_plugin})
+            message(FATAL_ERROR
+                "rexglue_ps4_configure_target: unknown GPU plugin '${_plugin}' (no target rexgpu-${_plugin})")
+        endif()
+        list(APPEND _whole "$<TARGET_FILE:rexgpu-${_plugin}>")
+        list(APPEND _libs rexgpu-${_plugin})
+    endforeach()
+    string(JOIN "," _whole_csv ${_whole})
+    target_link_options(${target_name} PRIVATE "LINKER:--whole-archive,${_whole_csv},--no-whole-archive")
+    set_property(TARGET ${target_name} APPEND PROPERTY LINK_DEPENDS ${_whole})
+    # Still linked normally, for the build order and their own dependencies (glslang, FFmpeg, ...).
+    target_link_libraries(${target_name} PRIVATE ${_libs})
+
+    # libScePad / libSceUserService (input), libSceAudioOut (audio): the system's stub libraries.
+    target_link_libraries(${target_name} PRIVATE -lScePad -lSceUserService -lSceAudioOut)
+
+    # rex_app.cpp includes imgui.h; rexruntime links imgui privately.
+    target_include_directories(${target_name} PRIVATE
+        $<TARGET_PROPERTY:imgui,INTERFACE_INCLUDE_DIRECTORIES>)
+endfunction()
diff --git a/sdk/include/rex/audio/ps4/ps4_audio_system.h b/sdk/include/rex/audio/ps4/ps4_audio_system.h
new file mode 100644
index 0000000..b87fa96
--- /dev/null
+++ b/sdk/include/rex/audio/ps4/ps4_audio_system.h
@@ -0,0 +1,76 @@
+/**
+ * @file        rex/audio/ps4/ps4_audio_system.h
+ * @brief       Audio output for the PS4 through libSceAudioOut
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <queue>
+#include <stack>
+#include <thread>
+#include <vector>
+
+#include <rex/audio/audio_driver.h>
+#include <rex/audio/audio_system.h>
+#include <rex/audio/downmix.h>
+#include <rex/thread.h>
+
+namespace rex::audio::ps4 {
+
+// One guest audio client (XAudio render client). The game's audio worker fills frames on request
+// (the semaphore); the output thread of PS4AudioSystem consumes them.
+class PS4AudioDriver final : public AudioDriver {
+ public:
+  static constexpr uint32_t kChannels = 6;
+  static constexpr uint32_t kChannelSamples = 256;
+  static constexpr uint32_t kFrameSamples = kChannels * kChannelSamples;
+
+  PS4AudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore);
+  ~PS4AudioDriver() override;
+
+  void SubmitFrame(uint32_t frame_ptr) override;
+
+  // Adds one queued frame, folded to stereo, into stereo_out. False if none was queued.
+  bool MixFrameInto(float* stereo_out, const StereoFold& fold, float gain);
+
+  size_t QueuedFrames();
+  void RequestFrame();
+
+ private:
+  rex::thread::Semaphore* semaphore_;
+  std::mutex frames_mutex_;
+  std::queue<float*> frames_queued_;
+  std::stack<float*> frames_unused_;
+};
+
+class PS4AudioSystem final : public AudioSystem {
+ public:
+  explicit PS4AudioSystem(runtime::FunctionDispatcher* function_dispatcher);
+  ~PS4AudioSystem() override;
+
+  static bool IsAvailable() { return true; }
+  static std::unique_ptr<AudioSystem> Create(runtime::FunctionDispatcher* function_dispatcher);
+
+  X_STATUS CreateDriver(size_t index, rex::thread::Semaphore* semaphore,
+                        AudioDriver** out_driver) override;
+  void DestroyDriver(AudioDriver* driver) override;
+
+ private:
+  bool StartOutput();
+  void StopOutput();
+  void OutputThreadMain();
+
+  int32_t port_ = -1;
+  std::thread thread_;
+  std::atomic<bool> running_{false};
+  std::mutex drivers_mutex_;
+  std::vector<PS4AudioDriver*> drivers_;
+};
+
+}  // namespace rex::audio::ps4
