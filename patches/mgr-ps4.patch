diff --git a/sdk/src/system/wait_report.cpp b/sdk/src/system/wait_report.cpp
new file mode 100644
index 0000000..17f275a
--- /dev/null
+++ b/sdk/src/system/wait_report.cpp
@@ -0,0 +1,176 @@
+/**
+ * @file        rex/system/wait_report.cpp
+ * @brief       The guest threads' current waits, reported in the log when they last (see wait_report.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/system/wait_report.h>
+
+#include <algorithm>
+#include <chrono>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <time.h>
+
+#include <fmt/format.h>
+
+#include <rex/chrono/clock.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/xobject.h>
+#include <rex/system/xthread.h>
+
+REXCVAR_DEFINE_BOOL(kernel_wait_report, true, "Kernel",
+                    "Diagnostic: record each guest wait (its objects and the guest function that made it) and list "
+                    "every guest thread waiting 2 s or more in the log every kernel_wait_report_s seconds ([waits])");
+REXCVAR_DEFINE_INT32(kernel_wait_report_s, 30, "Kernel", "Diagnostic: kernel_wait_report's period in seconds")
+    .range(5, 600);
+
+namespace rex::system::wait_report {
+
+__thread const void* g_export_caller = nullptr;
+
+namespace {
+
+uint64_t NowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+const char* KindName(uint32_t kind) {
+  switch (Kind(kind)) {
+    case Kind::kWait:
+      return "Wait";
+    case Kind::kWaitAny:
+      return "WaitAny";
+    case Kind::kWaitAll:
+      return "WaitAll";
+    case Kind::kSignalAndWait:
+      return "SignalAndWait";
+    case Kind::kDelay:
+      return "Delay";
+    default:
+      return "?";
+  }
+}
+
+const char* TypeName(uint32_t type) {
+  switch (XObject::Type(type)) {
+    case XObject::Type::Event:
+      return "Event";
+    case XObject::Type::File:
+      return "File";
+    case XObject::Type::IOCompletion:
+      return "IOCompletion";
+    case XObject::Type::Mutant:
+      return "Mutant";
+    case XObject::Type::NotifyListener:
+      return "NotifyListener";
+    case XObject::Type::Semaphore:
+      return "Semaphore";
+    case XObject::Type::Thread:
+      return "Thread";
+    case XObject::Type::Timer:
+      return "Timer";
+    default:
+      return "Object";
+  }
+}
+
+std::once_flag g_reporter_started;
+
+// mgr-ps4 (2026-11-04, the game "too fast like speed hacks"): the guest clock against real time at every report, and
+// once what clock_getres says (the source of the host tick rate before the PS4 counted the TSC).
+void ReporterMain() {
+  using chrono::Clock;
+  timespec res{};
+  clock_getres(CLOCK_MONOTONIC_RAW, &res);
+  REXLOG_INFO("[clock] host ticks at {} Hz; clock_getres(CLOCK_MONOTONIC_RAW) = {} ns ({} Hz by its formula); guest "
+              "ticks at {} Hz",
+              Clock::host_tick_frequency_platform(), res.tv_nsec, res.tv_nsec ? 1000000000ll / res.tv_nsec : 0,
+              Clock::guest_tick_frequency());
+  uint64_t guest_before = Clock::QueryGuestTickCount();
+  auto host_before = std::chrono::steady_clock::now();
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::seconds(std::clamp(REXCVAR_GET(kernel_wait_report_s), 5, 600)));
+    const uint64_t guest_now = Clock::QueryGuestTickCount();
+    const auto host_now = std::chrono::steady_clock::now();
+    if (REXCVAR_GET(kernel_wait_report)) {
+      const double guest_s = double(guest_now - guest_before) / double(Clock::guest_tick_frequency());
+      const double host_s = std::chrono::duration<double>(host_now - host_before).count();
+      REXLOG_INFO("[clock] guest time {:.2f} s in {:.2f} s of real time ({:.3f}x)", guest_s, host_s,
+                  host_s > 0 ? guest_s / host_s : 0.0);
+      Report(2000);
+    }
+    guest_before = guest_now;
+    host_before = host_now;
+  }
+}
+
+}  // namespace
+
+void Begin(Kind kind, XObject* const* objects, uint32_t count, bool alertable, int64_t timeout_ms) {
+  if (!REXCVAR_GET(kernel_wait_report) || !XThread::IsInThread()) return;
+  XThread* thread = XThread::GetCurrentThread();
+  if (!thread) return;
+  std::call_once(g_reporter_started, [] { std::thread(ReporterMain).detach(); });
+  Record& r = thread->wait_record();
+  r.kind.store(uint32_t(kind), std::memory_order_relaxed);
+  r.count.store(count, std::memory_order_relaxed);
+  for (uint32_t i = 0; i < std::min(count, kMaxObjects); ++i) {
+    r.handles[i].store(objects[i] ? objects[i]->handle() : 0, std::memory_order_relaxed);
+    r.types[i].store(objects[i] ? uint32_t(objects[i]->type()) : 0, std::memory_order_relaxed);
+  }
+  r.host_caller.store(reinterpret_cast<uint64_t>(g_export_caller), std::memory_order_relaxed);
+  const auto* state = thread->thread_state();
+  r.guest_lr.store(state && state->context() ? uint32_t(state->context()->lr) : 0, std::memory_order_relaxed);
+  r.alertable.store(alertable ? 1 : 0, std::memory_order_relaxed);
+  r.timeout_ms.store(timeout_ms, std::memory_order_relaxed);
+  r.since_ns.store(NowNs() | 1, std::memory_order_release);
+}
+
+void End() {
+  if (!XThread::IsInThread()) return;
+  if (XThread* thread = XThread::GetCurrentThread()) thread->wait_record().since_ns.store(0, std::memory_order_release);
+}
+
+void Report(uint64_t min_ms) {
+  KernelState* state = kernel_state();
+  if (!state) return;
+  auto threads = state->object_table()->GetObjectsByType<XThread>();
+  const uint64_t now = NowNs();
+  size_t shown = 0;
+  for (auto& thread : threads) {
+    Record& r = thread->wait_record();
+    const uint64_t since = r.since_ns.load(std::memory_order_acquire);
+    if (!since || now < since || now - since < min_ms * 1000000ull) continue;
+    const uint32_t count = r.count.load(std::memory_order_relaxed);
+    std::string objects;
+    for (uint32_t i = 0; i < std::min(count, kMaxObjects); ++i) {
+      fmt::format_to(std::back_inserter(objects), "{}{} {:08X}", i ? ", " : "",
+                     TypeName(r.types[i].load(std::memory_order_relaxed)),
+                     r.handles[i].load(std::memory_order_relaxed));
+    }
+    if (count > kMaxObjects) fmt::format_to(std::back_inserter(objects), " (+{} more)", count - kMaxObjects);
+    const int64_t timeout = r.timeout_ms.load(std::memory_order_relaxed);
+    REXLOG_INFO("[waits] {} ({:08X}): {:.1f} s in {}{} on {}{}; export caller host 0x{:X}, guest lr {:08X}",
+                thread->DebugName(), thread->handle(), double(now - since) / 1e9,
+                KindName(r.kind.load(std::memory_order_relaxed)),
+                r.alertable.load(std::memory_order_relaxed) ? " (alertable)" : "",
+                objects.empty() ? std::string("nothing") : objects,
+                timeout < 0 ? std::string() : fmt::format(", timeout {} ms", timeout),
+                r.host_caller.load(std::memory_order_relaxed), r.guest_lr.load(std::memory_order_relaxed));
+    ++shown;
+  }
+  REXLOG_INFO("[waits] {} of {} guest threads in a wait of {:.0f} s or more", shown, threads.size(),
+              double(min_ms) / 1000.0);
+}
+
+}  // namespace rex::system::wait_report
