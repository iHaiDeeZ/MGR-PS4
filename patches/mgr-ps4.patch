diff --git a/tools/ps4_unfused_fma.py b/tools/ps4_unfused_fma.py
new file mode 100644
index 0000000..660ff7d
--- /dev/null
+++ b/tools/ps4_unfused_fma.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""mgr-ps4 (2026-11-04): the guest's fused multiply-adds as REX_FMA, a multiply and an add on hosts without an FMA unit.
+
+The generator writes PPC's fmadd family (fmadd, fmsub, fnmadd, fnmsub and their single forms) as std::fma. The
+PS4's Jaguar has no FMA instruction, so std::fma is libm's software emulation (musl's fma with its normalize/scalbn
+helpers): in the first console profile (DESIGN.md, "The first CPU profile") a third of Wwise's audio thread, which
+was 94 % busy. REX_FMA(a, b, c) is that call where the host has FMA (__FMA__) and ((a) * (b) + (c)) where it has not.
+For single-precision operands (the fmadds family, and the game's float math) the result is the fused one: the product
+of two 24-bit mantissas is exact in a double, so the double add rounds once, as std::fma does. Only double-precision
+operands can differ, in the last bit (Xenia computes the same way on CPUs without FMA).
+
+Idempotent. Run after tools/post_codegen.py (scripts/build-mgr.sh codegen):
+  python3 tools/ps4_unfused_fma.py --gen app/generated/default
+"""
+import argparse
+import os
+import sys
+
+MARKER = '// mgr-ps4: fused multiply-adds (tools/ps4_unfused_fma.py)'
+BLOCK = MARKER + '''
+#ifndef REX_FMA
+#if defined(__PS4__) && !defined(__FMA__)
+#define REX_FMA(a, b, c) ((a) * (b) + (c))
+#else
+#define REX_FMA(a, b, c) std::fma((a), (b), (c))
+#endif
+#endif
+'''
+ANCHOR = '#define REX_MEMORY_SIZE 0x100000000ull\n'
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    ap.add_argument('--gen', required=True, help='the generated tree (app/generated/default)')
+    args = ap.parse_args()
+    pch = os.path.join(args.gen, 'sa2_pch.h')
+    text = open(pch, encoding='utf-8').read()
+    if MARKER not in text:
+        if text.count(ANCHOR) != 1:
+            sys.exit(f'ps4_unfused_fma: {pch} has {text.count(ANCHOR)} anchors "{ANCHOR.strip()}"')
+        text = text.replace(ANCHOR, ANCHOR + BLOCK)
+        with open(pch, 'w', encoding='utf-8', newline='\n') as f:
+            f.write(text)
+    files = sites = 0
+    for name in sorted(os.listdir(args.gen)):
+        if not name.endswith('.cpp'):
+            continue
+        path = os.path.join(args.gen, name)
+        text = open(path, encoding='utf-8').read()
+        n = text.count('std::fma(')
+        if not n:
+            continue
+        with open(path, 'w', encoding='utf-8', newline='\n') as f:
+            f.write(text.replace('std::fma(', 'REX_FMA('))
+        files += 1
+        sites += n
+    print(f'ps4_unfused_fma: {sites} std::fma calls as REX_FMA in {files} files; REX_FMA in {pch}')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/ro_constants.py b/tools/ro_constants.py
index 89f602c..d04fc49 100644
--- a/tools/ro_constants.py
+++ b/tools/ro_constants.py
@@ -57,6 +57,8 @@ CALL = re.compile(r'\(ctx, base[,)]|REX_CALL_INDIRECT_|ppc_trap\(')
 STRUCTURED = re.compile(r'^\t+(?:switch|for|while|do|else|case|default|try|catch)\b|[{}]\s*$|^\t*\}')
 SIZE = {'U8': 1, 'U16': 2, 'U32': 4, 'U64': 8}
 MARKER = '// rexglue ports: constants of the read-only data folded (tools/ro_constants.py)'
+# mgr-ps4 (2026-11-04): the PS4 takes the Switch's bare constants too (the PC's checked loads count every use in
