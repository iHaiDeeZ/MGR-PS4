+/**
+ * @file        rex/core/seh_ps4.cpp
+ * @brief       SEH interface on the PS4
+ *
+ * seh_posix.cpp installs its own SIGSEGV/SIGBUS handlers and throws a C++ exception out of the
+ * signal frame. On the PS4 that would replace the guest memory handler (exception_handler_ps4.cpp:
+ * sibling faults, MMIO, write watches), and unwinding through a kernel signal frame is not
+ * something OpenOrbis's libunwind is known to do. So faults inside SEH scopes are fatal here, as on
+ * the Switch: they reach the kit's crash log through the exception handler's chain.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_PS4
+
+#include <cstdlib>
+
+#include <rex/platform/exceptions.h>
+#include <rex/platform/seh.h>
+
+namespace rex::platform {
+
+static thread_local SehThreadState tls_seh_state;
+static thread_local bool tls_seh_active = false;
+
+SehThreadState& seh_thread_state() { return tls_seh_state; }
+
+int seh_filter(uint32_t /*code*/, void* /*exception_pointers*/) {
+  // Only used on Windows.
+  return 0;
+}
+
+[[noreturn]] void seh_rethrow() { std::abort(); }
+
+void seh_initialize() { g_seh_initialized.store(true); }
+
+bool& seh_active() { return tls_seh_active; }
+
+}  // namespace rex::platform
+
+#endif  // REX_PLATFORM_PS4
