 #include <cstddef>
 
-// Switch goes before Linux on purpose: platform.h turns on both, and
-// Horizon has no <ucontext.h>.
-#if REX_PLATFORM_SWITCH
+// Switch and PS4 go before Linux on purpose: platform.h turns on both, and
+// neither has a usable makecontext.
+#if REX_PLATFORM_SWITCH || REX_PLATFORM_PS4
 #include <cstdint>
 #include <vector>
 #elif REX_PLATFORM_LINUX || REX_PLATFORM_MAC
@@ -35,6 +35,10 @@
 /// assembly trampoline in fiber_switch.cpp, and never returns.
 extern "C" [[noreturn]] void rex_fiber_trampoline(void);
 #endif
+#if REX_PLATFORM_PS4
+/// First C++ code that runs on a new PS4 fiber (fiber_ps4.cpp); never returns.
+extern "C" [[noreturn]] void rex_ps4_fiber_entry(void);
+#endif
 
 namespace rex::thread {
 
@@ -91,6 +95,16 @@ struct Fiber {
   bool is_thread_fiber_ = false;
 
   friend void ::rex_fiber_trampoline(void);
+#elif REX_PLATFORM_PS4
+  // x86-64 System V: the switch pushes the callee-saved registers (rbx, rbp, r12-r15, MXCSR and
+  // the x87 control word) on the fiber's own stack, so the context is just its stack pointer.
+  uint64_t rsp_ = 0;
+  std::vector<uint8_t> stack_;
+  void (*entry_)(void*) = nullptr;
+  void* arg_ = nullptr;
+  bool is_thread_fiber_ = false;
+
+  friend void ::rex_ps4_fiber_entry(void);
 #elif REX_PLATFORM_LINUX || REX_PLATFORM_MAC
