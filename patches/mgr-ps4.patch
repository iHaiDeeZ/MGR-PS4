+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+//_____________________________________________________________/\_______________________________________________________________
+//==============================================================================================================================
+//
+//                                       FSR - [TEPD] TEMPORAL ENERGY PRESERVING DITHER
+//
+//------------------------------------------------------------------------------------------------------------------------------
+// Temporally energy preserving dithered {0 to 1} linear to gamma 2.0 conversion.
+// Gamma 2.0 is used so that the conversion back to linear is just to square the color.
+// The conversion comes in 8-bit and 10-bit modes, designed for output to 8-bit UNORM or 10:10:10:2 respectively.
+// Given good non-biased temporal blue noise as dither input,
+// the output dither will temporally conserve energy.
+// This is done by choosing the linear nearest step point instead of perceptual nearest.
+// See code below for details.
+//------------------------------------------------------------------------------------------------------------------------------
+// DX SPEC RULES FOR FLOAT->UNORM 8-BIT CONVERSION
+// ===============================================
+// - Output is 'uint(floor(saturate(n)*255.0+0.5))'.
+// - Thus rounding is to nearest.
+// - NaN gets converted to zero.
+// - INF is clamped to {0.0 to 1.0}.
+//==============================================================================================================================
+#if defined(A_GPU)
+ // Hand tuned integer position to dither value, with more values than simple checkerboard.
+ // Only 32-bit has enough precision for this compddation.
+ // Output is {0 to <1}.
+ AF1 FsrTepdDitF(AU2 p,AU1 f){
+  AF1 x=AF1_(p.x+f);
+  AF1 y=AF1_(p.y);
+  // The 1.61803 golden ratio.
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  // Number designed to provide a good visual pattern.
+  AF1 b=AF1_(1.0/3.69);
+  x=x*a+(y*b);
+  return AFractF1(x);}
+//------------------------------------------------------------------------------------------------------------------------------
+ // This version is 8-bit gamma 2.0.
+ // The 'c' input is {0 to 1}.
+ // Output is {0 to 1} ready for image store.
+ void FsrTepdC8F(inout AF3 c,AF1 dit){
+  AF3 n=sqrt(c);
+  n=floor(n*AF3_(255.0))*AF3_(1.0/255.0);
+  AF3 a=n*n;
+  AF3 b=n+AF3_(1.0/255.0);b=b*b;
+  // Ratio of 'a' to 'b' required to produce 'c'.
+  // APrxLoRcpF1() won't work here (at least for very high dynamic ranges).
+  // APrxMedRcpF1() is an IADD,FMA,MUL.
+  AF3 r=(c-b)*APrxMedRcpF3(a-b);
+  // Use the ratio as a cutoff to choose 'a' or 'b'.
+  // AGtZeroF1() is a MUL.
+  c=ASatF3(n+AGtZeroF3(AF3_(dit)-r)*AF3_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ // This version is 10-bit gamma 2.0.
+ // The 'c' input is {0 to 1}.
+ // Output is {0 to 1} ready for image store.
+ void FsrTepdC10F(inout AF3 c,AF1 dit){
+  AF3 n=sqrt(c);
+  n=floor(n*AF3_(1023.0))*AF3_(1.0/1023.0);
+  AF3 a=n*n;
+  AF3 b=n+AF3_(1.0/1023.0);b=b*b;
+  AF3 r=(c-b)*APrxMedRcpF3(a-b);
+  c=ASatF3(n+AGtZeroF3(AF3_(dit)-r)*AF3_(1.0/1023.0));}
+#endif
+//==============================================================================================================================
+#if defined(A_GPU)&&defined(A_HALF)
+ AH1 FsrTepdDitH(AU2 p,AU1 f){
+  AF1 x=AF1_(p.x+f);
+  AF1 y=AF1_(p.y);
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  AF1 b=AF1_(1.0/3.69);
+  x=x*a+(y*b);
+  return AH1(AFractF1(x));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC8H(inout AH3 c,AH1 dit){
+  AH3 n=sqrt(c);
+  n=floor(n*AH3_(255.0))*AH3_(1.0/255.0);
+  AH3 a=n*n;
+  AH3 b=n+AH3_(1.0/255.0);b=b*b;
+  AH3 r=(c-b)*APrxMedRcpH3(a-b);
+  c=ASatH3(n+AGtZeroH3(AH3_(dit)-r)*AH3_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC10H(inout AH3 c,AH1 dit){
+  AH3 n=sqrt(c);
+  n=floor(n*AH3_(1023.0))*AH3_(1.0/1023.0);
+  AH3 a=n*n;
+  AH3 b=n+AH3_(1.0/1023.0);b=b*b;
+  AH3 r=(c-b)*APrxMedRcpH3(a-b);
+  c=ASatH3(n+AGtZeroH3(AH3_(dit)-r)*AH3_(1.0/1023.0));}
+//==============================================================================================================================
+ // This computes dither for positions 'p' and 'p+{8,0}'.
+ AH2 FsrTepdDitHx2(AU2 p,AU1 f){
+  AF2 x;
+  x.x=AF1_(p.x+f);
+  x.y=x.x+AF1_(8.0);
+  AF1 y=AF1_(p.y);
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  AF1 b=AF1_(1.0/3.69);
+  x=x*AF2_(a)+AF2_(y*b);
+  return AH2(AFractF2(x));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC8Hx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 dit){
+  AH2 nR=sqrt(cR);
+  AH2 nG=sqrt(cG);
+  AH2 nB=sqrt(cB);
+  nR=floor(nR*AH2_(255.0))*AH2_(1.0/255.0);
+  nG=floor(nG*AH2_(255.0))*AH2_(1.0/255.0);
+  nB=floor(nB*AH2_(255.0))*AH2_(1.0/255.0);
+  AH2 aR=nR*nR;
+  AH2 aG=nG*nG;
+  AH2 aB=nB*nB;
+  AH2 bR=nR+AH2_(1.0/255.0);bR=bR*bR;
+  AH2 bG=nG+AH2_(1.0/255.0);bG=bG*bG;
+  AH2 bB=nB+AH2_(1.0/255.0);bB=bB*bB;
+  AH2 rR=(cR-bR)*APrxMedRcpH2(aR-bR);
+  AH2 rG=(cG-bG)*APrxMedRcpH2(aG-bG);
+  AH2 rB=(cB-bB)*APrxMedRcpH2(aB-bB);
+  cR=ASatH2(nR+AGtZeroH2(dit-rR)*AH2_(1.0/255.0));
+  cG=ASatH2(nG+AGtZeroH2(dit-rG)*AH2_(1.0/255.0));
+  cB=ASatH2(nB+AGtZeroH2(dit-rB)*AH2_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC10Hx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 dit){
+  AH2 nR=sqrt(cR);
+  AH2 nG=sqrt(cG);
+  AH2 nB=sqrt(cB);
+  nR=floor(nR*AH2_(1023.0))*AH2_(1.0/1023.0);
+  nG=floor(nG*AH2_(1023.0))*AH2_(1.0/1023.0);
+  nB=floor(nB*AH2_(1023.0))*AH2_(1.0/1023.0);
+  AH2 aR=nR*nR;
+  AH2 aG=nG*nG;
+  AH2 aB=nB*nB;
+  AH2 bR=nR+AH2_(1.0/1023.0);bR=bR*bR;
+  AH2 bG=nG+AH2_(1.0/1023.0);bG=bG*bG;
+  AH2 bB=nB+AH2_(1.0/1023.0);bB=bB*bB;
+  AH2 rR=(cR-bR)*APrxMedRcpH2(aR-bR);
+  AH2 rG=(cG-bG)*APrxMedRcpH2(aG-bG);
+  AH2 rB=(cB-bB)*APrxMedRcpH2(aB-bB);
+  cR=ASatH2(nR+AGtZeroH2(dit-rR)*AH2_(1.0/1023.0));
+  cG=ASatH2(nG+AGtZeroH2(dit-rG)*AH2_(1.0/1023.0));
+  cB=ASatH2(nB+AGtZeroH2(dit-rB)*AH2_(1.0/1023.0));}
+#endif
diff --git a/app/src/renut_engine/gpu/shaders/host/fsr_easu_ps.hlsl b/app/src/renut_engine/gpu/shaders/host/fsr_easu_ps.hlsl
new file mode 100644
index 0000000..8866c70
--- /dev/null
+++ b/app/src/renut_engine/gpu/shaders/host/fsr_easu_ps.hlsl
@@ -0,0 +1,59 @@
+// mgr-ps4 (2026-11-04, renut_fsr): FSR 1's edge-adaptive upscale (EASU, AMD FidelityFX Super Resolution 1.0,
+// ffx_fsr1.h, MIT) of the game's frame to the present's viewport, into Renut's FSR target (present.cpp). present_vs
+// draws it. UtilityPush:
+//   scale, translate  the frame's share of its texture (UV), as present_ps reads it
+//   textureIndex      the frame's bindless slot
+//   samplerIndex      a clamping sampler (the gathers take its addressing, not its filter)
+//   param0, param1    the target's width and height in pixels
+// FsrEasuConOffset's four constants (ffx_fsr1.h, A_CPU) are worked out here, per pixel: a dozen instructions, and the
+// utility layout keeps its 32-byte push block.
+#include "utility.hlsli"
+
+#define A_GPU 1
+#define A_HLSL 1
+#include "ffx_a.h"
+
+AF4 FsrEasuRF(AF2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GatherRed(
+        g_Samplers[NonUniformResourceIndex(g_Push.samplerIndex)], p);
+}
+AF4 FsrEasuGF(AF2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GatherGreen(
+        g_Samplers[NonUniformResourceIndex(g_Push.samplerIndex)], p);
+}
+AF4 FsrEasuBF(AF2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GatherBlue(
+        g_Samplers[NonUniformResourceIndex(g_Push.samplerIndex)], p);
+}
+
+#define FSR_EASU_F 1
+#include "ffx_fsr1.h"
+
+struct PSInput
+{
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+float4 main(PSInput input) : SV_Target0
+{
+    uint width, height;
+    g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GetDimensions(width, height);
+    const float2 size = float2(width, height);
+    const float2 rcp_size = 1.0 / size;
+    // The input viewport: the frame's pixels shown, and where they start in the texture.
+    const float2 region = g_Push.scale * size;
+    const float2 offset = g_Push.translate * size;
+    const float2 ratio = region / float2(g_Push.param0, g_Push.param1);
+    const AU4 con0 = AU4(asuint(ratio.x), asuint(ratio.y), asuint(0.5 * ratio.x - 0.5 + offset.x),
+                         asuint(0.5 * ratio.y - 0.5 + offset.y));
+    const AU4 con1 = AU4(asuint(rcp_size.x), asuint(rcp_size.y), asuint(rcp_size.x), asuint(-rcp_size.y));
+    const AU4 con2 = AU4(asuint(-rcp_size.x), asuint(2.0 * rcp_size.y), asuint(rcp_size.x), asuint(2.0 * rcp_size.y));
+    const AU4 con3 = AU4(asuint(0.0), asuint(4.0 * rcp_size.y), 0u, 0u);
+    AF3 color;
+    FsrEasuF(color, AU2(input.position.xy), con0, con1, con2, con3);
+    return float4(color, 1.0);
+}
diff --git a/app/src/renut_engine/gpu/shaders/host/fsr_rcas_ps.hlsl b/app/src/renut_engine/gpu/shaders/host/fsr_rcas_ps.hlsl
new file mode 100644
index 0000000..f9e0b39
--- /dev/null
+++ b/app/src/renut_engine/gpu/shaders/host/fsr_rcas_ps.hlsl
@@ -0,0 +1,51 @@
+// mgr-ps4 (2026-11-04, renut_fsr): FSR 1's sharpening (RCAS, ffx_fsr1.h, MIT) of the EASU target onto the back buffer,
+// then the scan-out's gamma ramp and exponent, as present_ps applies them. present_vs draws it over the frame's
+// viewport. UtilityPush:
+//   textureIndex   the FSR target's bindless slot (one texel per output pixel, EASU's picture in its top-left corner)
+//   samplerIndex   no sampler (RCAS loads): the width EASU wrote in the low 16 bits, the height in the high 16
+//   translate      the viewport's top-left corner in pixels, the target's (0, 0)
+//   scale.x        the sharpness in stops (0 = the most; each stop halves it: FsrRcasCon)
+//   param0         the output gamma exponent (1 = passthrough), as present_ps
+//   param1         its bits, when not 0: the game's gamma ramp's bindless slot, as present_ps
+#include "utility.hlsli"
+
+#define A_GPU 1
+#define A_HLSL 1
+#include "ffx_a.h"
+
+AF4 FsrRcasLoadF(ASU2 p)
+{
+    // The 3x3 neighbourhood at the picture's edges: the edge texel again (past it lie stale texels, or none).
+    const ASU2 last = ASU2(int(g_Push.samplerIndex & 0xFFFFu), int(g_Push.samplerIndex >> 16)) - 1;
+    const ASU2 clamped = clamp(p, ASU2(0, 0), last);
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].Load(int3(clamped, 0));
+}
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+
+#define FSR_RCAS_F 1
+#include "ffx_fsr1.h"
+
+struct PSInput
+{
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+float4 main(PSInput input) : SV_Target0
+{
+    const AU4 con = AU4(asuint(exp2(-g_Push.scale.x)), 0u, 0u, 0u);
+    float4 color = float4(0.0, 0.0, 0.0, 1.0);
+    FsrRcasF(color.r, color.g, color.b, AU2(max(input.position.xy - g_Push.translate, 0.0)), con);
+    // present_ps.hlsl's ramp lookup and exponent (see there).
+    const uint ramp = asuint(g_Push.param1);
+    if (ramp != 0u)
+    {
+        const uint3 i = uint3(saturate(color.rgb) * 255.0 + 0.5);
+        color.rgb = float3(g_Textures[NonUniformResourceIndex(ramp)].Load(int3(i.x, 0, 0)).x,
+                           g_Textures[NonUniformResourceIndex(ramp)].Load(int3(i.y, 0, 0)).y,
+                           g_Textures[NonUniformResourceIndex(ramp)].Load(int3(i.z, 0, 0)).z);
+    }
+    if (g_Push.param0 != 1.0)
+        color.rgb = pow(saturate(color.rgb), g_Push.param0);
+    return float4(color.rgb, 1.0);
+}
