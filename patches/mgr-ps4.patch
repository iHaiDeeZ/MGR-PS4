diff --git a/app/mgr_src/mgr_ps4.cpp b/app/mgr_src/mgr_ps4.cpp
new file mode 100644
index 0000000..11f6823
--- /dev/null
+++ b/app/mgr_src/mgr_ps4.cpp
@@ -0,0 +1,14 @@
+// Metal Gear Rising: Revengeance on the PS4: the port's settings for ps4-kit's runtime.
+//
+// /data/MGR is the app's folder: mgr.toml (written on the first start), the logs, the caches, the kit's boot trace
+// and crash log, and the game itself in game_root/ (default.xex and media/ from your own disc). The SDK's
+// executable and user folders point here (sdk/src/core/filesystem_posix.cpp), because /app0 is read-only.
+
+#include <ps4_kit.h>
+#include <ps4_kit_diag.h>
+
+PS4_DIAG_DATA_DIR("/data/MGR");
+
+extern "C" void ps4_kit_configure_heap(ps4_kit_heap_options* options) {
+  options->log_tag = "mgr";
+}
diff --git a/app/mgr_src/mgr_ps4_menu.cpp b/app/mgr_src/mgr_ps4_menu.cpp
new file mode 100644
index 0000000..2058b39
--- /dev/null
+++ b/app/mgr_src/mgr_ps4_menu.cpp
@@ -0,0 +1,254 @@
+// Metal Gear Rising on the PS4 (2026-11-04, the user's request: "add quick menu l3 + r3, add frame counter"): the frame
+// counter in the top-left corner and the quick menu that L3+R3 opens, in one ImGui dialog that lives for the whole
+// session. The SDK's ImGui draws it (Renut's overlay, over every presented frame and on its own while the game loads),
+// the DualShock 4 drives it (rex/ui/ps4_imgui_input.h), and the game gets a neutral pad while the menu has the focus
+// (ReXApp's active callback). Its settings are the cvars below and Renut's, saved to mgr.toml when it closes.
+
+#include "mgr_ps4_menu.h"
+
+#include <cmath>
+#include <string>
+#include <utility>
+
+#include <imgui.h>
+
+#include <ps4_kit_diag.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/imgui_dialog.h>
+
+#include "renut_engine/perf/frame_stats.h"
+
+REXCVAR_DEFINE_INT32(mgr_frame_counter, 1, "MGR",
+                     "PS4: the frame counter in the top-left corner: 0 = off, 1 = frames a second, 2 = with the frame "
+                     "time and the game thread, render thread and GPU times a frame")
+    .range(0, 2);
+
+namespace mgr::ps4 {
+
+namespace {
+
+// The render heights offered (sa2_render_height_*; the width follows at 16:9). 1080p needs about twice the GPU time
+// of 720p.
+struct Resolution {
+  const char* label;
+  int32_t height;
+};
+constexpr Resolution kResolutions[] = {{"360p", 360}, {"480p", 480}, {"720p", 720}, {"1080p", 1080}};
+
+// renut_fsr_sharpness, in stops (0 = the most).
+struct Sharpness {
+  const char* label;
+  double stops;
+};
+constexpr Sharpness kSharpness[] = {{"Soft", 1.0}, {"Medium", 0.5}, {"Sharp", 0.2}};
+
+constexpr const char* kCounterModes[] = {"Off", "FPS", "Detailed"};
+
+// The burst profiler (ps4-kit's ps4_profile.cpp): every thread of the app sampled for this long, written to
+// <data dir>/profiles/profile_<n>.txt. Started from the menu only.
+constexpr double kProfileSeconds = 8.0;
+
+// The pad buttons that, held when the menu closes, would reach the game as a press: it keeps the focus until they are
+// released.
+constexpr ImGuiKey kHeldKeys[] = {
+    ImGuiKey_GamepadFaceDown,  ImGuiKey_GamepadFaceRight, ImGuiKey_GamepadFaceUp,   ImGuiKey_GamepadFaceLeft,
+    ImGuiKey_GamepadDpadUp,    ImGuiKey_GamepadDpadDown,  ImGuiKey_GamepadDpadLeft, ImGuiKey_GamepadDpadRight,
+    ImGuiKey_GamepadL1,        ImGuiKey_GamepadR1,        ImGuiKey_GamepadL3,       ImGuiKey_GamepadR3,
+    ImGuiKey_GamepadStart,     ImGuiKey_GamepadBack,
+};
+
+bool AnyButtonDown() {
+  for (const ImGuiKey key : kHeldKeys) {
+    if (ImGui::IsKeyDown(key)) return true;
+  }
+  return false;
+}
+
+void SetCvar(const char* name, const std::string& value) {
+  if (!rex::cvar::SetFlagByName(name, value)) REXLOG_WARN("[menu] could not set {} = {}", name, value);
+}
+
+class QuickMenu final : public rex::ui::ImGuiDialog {
+ public:
+  QuickMenu(rex::ui::ImGuiDrawer* drawer, std::filesystem::path config)
+      : ImGuiDialog(drawer), config_(std::move(config)) {}
+
+ protected:
+  void OnDraw(ImGuiIO& io) override {
+    // L3+R3 opens and closes the menu: both down, at the moment the second one goes down.
+    const bool combo = ImGui::IsKeyDown(ImGuiKey_GamepadL3) && ImGui::IsKeyDown(ImGuiKey_GamepadR3);
+    if (combo && !combo_held_) {
+      if (state_ == State::kOpen) {
+        Close();
+      } else {
+        state_ = State::kOpen;
+        focus_ = true;
+        REXLOG_INFO("[menu] opened (L3+R3)");
+      }
+    }
+    combo_held_ = combo;
+    if (state_ == State::kReleasing && !AnyButtonDown()) state_ = State::kClosed;
+    if (start_profile_ && state_ == State::kClosed) {
+      start_profile_ = false;
+      ps4_profile_set_enabled(1);
+      const bool started = ps4_profile_start(kProfileSeconds, "quick menu");
+      REXLOG_INFO("[menu] CPU profile of {:.0f} s {}", kProfileSeconds, started ? "started" : "not started");
+    }
+    DrawCounter();
+    if (state_ == State::kOpen) DrawMenu(io);
+    if (state_ == State::kReleasing) HoldFocus();
+  }
+
+ private:
+  enum class State {
+    kClosed,
+    kOpen,
+    kReleasing,  // closed, keeping the pad until the buttons that closed it are released
+  };
+
+  void Close() {
+    state_ = AnyButtonDown() ? State::kReleasing : State::kClosed;
+    rex::cvar::SaveConfig(config_);
+    REXLOG_INFO("[menu] closed: render height {}, FSR {} (sharpness {:.2f}), frame counter {}",
+                rex::cvar::Query<int32_t>("sa2_render_height_handheld"), rex::cvar::Query<bool>("renut_fsr"),
+                rex::cvar::Query<double>("renut_fsr_sharpness"), REXCVAR_GET(mgr_frame_counter));
+  }
+
+  void DrawCounter() {
+    const int32_t mode = REXCVAR_GET(mgr_frame_counter);
+    const bool profiling = ps4_profile_running() != 0;
+    if (mode <= 0 && !profiling) return;
+    const renut::frame_stats::Snapshot stats = renut::frame_stats::Get();
+    ImGui::SetNextWindowPos(ImVec2(8.0f, 8.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowBgAlpha(0.45f);
+    ImGui::Begin("##mgr-frame-counter", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoSavedSettings |
+                     ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoBringToFrontOnFocus);
+    ImGui::PushFont(nullptr, ImGui::GetStyle().FontSizeBase * 1.6f);
+    if (mode >= 1) {
+      const ImVec4 colour = stats.fps >= 57.0   ? ImVec4(0.45f, 1.0f, 0.45f, 1.0f)
+                            : stats.fps >= 29.0 ? ImVec4(1.0f, 0.9f, 0.35f, 1.0f)
+                                                : ImVec4(1.0f, 0.45f, 0.4f, 1.0f);
+      ImGui::TextColored(colour, "%.0f FPS", stats.fps);
+    }
+    if (mode >= 2) {
+      ImGui::Text("frame %.1f ms (worst %.1f)", stats.frame_ms, stats.worst_ms);
+      ImGui::Text("game %.1f ms", stats.cpu_ms);
+      if (stats.render_thread_known) ImGui::Text("render %.1f ms", stats.render_thread_ms);
+      if (stats.gpu_known) ImGui::Text("GPU %.1f ms", stats.gpu_ms);
+    }
+    if (profiling) ImGui::TextColored(ImVec4(1.0f, 0.6f, 0.2f, 1.0f), "CPU profile running");
+    ImGui::PopFont();
+    ImGui::End();
+  }
+
+  void DrawMenu(ImGuiIO& io) {
+    if (focus_) {
+      ImGui::SetNextWindowFocus();
+      focus_ = false;
+    }
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f), ImGuiCond_Always,
+                            ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowBgAlpha(0.92f);
+    if (!ImGui::Begin("Metal Gear Rising: Revengeance##mgr-quick-menu", nullptr,
+                      ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+                          ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_AlwaysAutoResize)) {
+      ImGui::End();
+      return;
+    }
+    ImGui::PushFont(nullptr, ImGui::GetStyle().FontSizeBase * 1.6f);
+
+    ImGui::SeparatorText("Graphics");
+    Row("Resolution");
+    const int32_t height = rex::cvar::Query<int32_t>("sa2_render_height_handheld");
+    for (const Resolution& r : kResolutions) {
+      ImGui::SameLine();
+      if (ImGui::RadioButton(r.label, height == r.height)) {
+        SetCvar("sa2_render_height_handheld", std::to_string(r.height));
+        SetCvar("sa2_render_height_docked", std::to_string(r.height));
+      }
+    }
+    Row("Upscaling");
+    const bool fsr = rex::cvar::Query<bool>("renut_fsr");
+    ImGui::SameLine();
+    if (ImGui::RadioButton("FSR 1", fsr)) SetCvar("renut_fsr", "true");
+    ImGui::SameLine();
+    if (ImGui::RadioButton("Bilinear", !fsr)) SetCvar("renut_fsr", "false");
+    if (fsr) {
+      Row("Sharpness");
+      const double stops = rex::cvar::Query<double>("renut_fsr_sharpness");
+      for (const Sharpness& s : kSharpness) {
+        ImGui::SameLine();
+        if (ImGui::RadioButton(s.label, std::abs(stops - s.stops) < 0.01))
+          SetCvar("renut_fsr_sharpness", std::to_string(s.stops));
+      }
+    }
+    // No vsync switch: renut_vsync rebuilds the swapchain, which the kit's VideoOut layer has not been tried with.
+
+    ImGui::SeparatorText("Frame counter");
+    Row("Show");
+    const int32_t mode = REXCVAR_GET(mgr_frame_counter);
+    for (int32_t i = 0; i < 3; ++i) {
+      ImGui::SameLine();
+      if (ImGui::RadioButton(kCounterModes[i], mode == i)) SetCvar("mgr_frame_counter", std::to_string(i));
+    }
+
+    ImGui::SeparatorText("Diagnostics");
+    bool waits = rex::cvar::Query<bool>("kernel_wait_report");
+    if (ImGui::Checkbox("Log the game's long waits (every 30 s)", &waits))
+      SetCvar("kernel_wait_report", waits ? "true" : "false");
+    if (ImGui::Button("Record a CPU profile")) {
+      start_profile_ = true;
+      Close();
+    }
+    ImGui::SameLine();
+    ImGui::TextDisabled("%.0f s of play after the menu closes, to %s/profiles", kProfileSeconds, ps4_diag_data_dir());
+
+    ImGui::Separator();
+    if (ImGui::Button("Close")) Close();
+    ImGui::SameLine();
+    ImGui::TextDisabled("L3+R3 or Circle closes the menu and saves the settings");
+    // Circle closes it when no widget is being edited (ImGui's own "back" otherwise).
+    if (state_ == State::kOpen && ImGui::IsWindowFocused() && !ImGui::IsAnyItemActive() &&
+        ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false))
+      Close();
+
+    ImGui::PopFont();
+    ImGui::End();
+  }
+
+  // A label column, so the choices line up.
+  static void Row(const char* label) {
+    ImGui::TextUnformatted(label);
+    ImGui::SameLine(ImGui::GetFontSize() * 7.0f);
+    ImGui::Dummy(ImVec2(0.0f, 0.0f));
+  }
+
+  // While the buttons that closed the menu are held: an empty window keeps the navigation focus (so the game's pad
+  // stays neutral) until they are released.
+  void HoldFocus() {
+    ImGui::SetNextWindowPos(ImVec2(-100.0f, -100.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowSize(ImVec2(1.0f, 1.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowFocus();
+    ImGui::Begin("##mgr-menu-release", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoSavedSettings);
+    ImGui::End();
+  }
+
+  std::filesystem::path config_;
+  State state_ = State::kClosed;
+  bool combo_held_ = false;
+  bool focus_ = false;
+  bool start_profile_ = false;
+};
+
+}  // namespace
+
+std::unique_ptr<rex::ui::ImGuiDialog> CreateQuickMenu(rex::ui::ImGuiDrawer* drawer, std::filesystem::path config) {
+  return std::make_unique<QuickMenu>(drawer, std::move(config));
+}
+
+}  // namespace mgr::ps4
