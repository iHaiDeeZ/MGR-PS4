diff --git a/sdk/src/audio/ps4/ps4_audio_system.cpp b/sdk/src/audio/ps4/ps4_audio_system.cpp
new file mode 100644
index 0000000..232727b
--- /dev/null
+++ b/sdk/src/audio/ps4/ps4_audio_system.cpp
@@ -0,0 +1,221 @@
+/**
+ * @file        rex/audio/ps4/ps4_audio_system.cpp
+ * @brief       Audio output for the PS4 through libSceAudioOut
+ *
+ * One main port: 48 kHz, float stereo, 256 samples a buffer, which is exactly one 360 audio frame
+ * (6 channels x 256 samples). sceAudioOutOutput blocks until the port takes the next buffer, so the
+ * output thread runs at the hardware's pace (5.333 ms a frame) and needs no timer of its own.
+ *
+ * Pacing, as the PC's SDL pump does it: before each buffer, every client with fewer than
+ * kTargetQueuedFrames frames queued is asked for one more (two if it is nearly empty). A client
+ * with nothing queued plays silence for that buffer. The game's 5.1 (FL FR FC LFE BL BR) is folded
+ * to the TV's stereo with the SDK's StereoFold, like the other back ends.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/audio/ps4/ps4_audio_system.h>
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+
+#include <rex/assert.h>
+#include <rex/audio/conversion.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <pthread.h>
+#include <pthread_np.h>
+
+// libSceAudioOut, declared by hand (the OpenOrbis header pulls in its own integer typedefs).
+extern "C" {
+int32_t sceAudioOutInit(void);
+int32_t sceAudioOutOpen(int32_t user_id, int32_t type, int32_t index, uint32_t length,
+                        uint32_t sample_rate, uint32_t param);
+int32_t sceAudioOutClose(int32_t handle);
+int32_t sceAudioOutOutput(int32_t handle, const void* buffer);
+int32_t sceAudioOutSetVolume(int32_t handle, int32_t flag, int32_t* volume);
+}
+
+REXCVAR_DEFINE_BOOL(audio_mute, false, "Audio", "Mute audio output");
+REXCVAR_DEFINE_INT32(audio_ps4_frames_in_queue, 6, "Audio",
+                     "Game audio frames kept queued per client ahead of the PS4's output port "
+                     "(5.333 ms each); read when the audio is opened");
+
+namespace rex::audio::ps4 {
+
+namespace {
+
+constexpr int32_t kSystemUser = 255;            // plays whoever is signed in
+constexpr int32_t kPortTypeMain = 0;
+constexpr uint32_t kFormatFloatStereo = 4;      // SCE_AUDIO_OUT_PARAM_FORMAT_FLOAT_STEREO
+constexpr uint32_t kAlreadyInitialized = 0x8026000Eu;
+constexpr size_t kMinQueuedFrames = 2;
+
+}  // namespace
+
+PS4AudioDriver::PS4AudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+    : AudioDriver(memory), semaphore_(semaphore) {}
+
+PS4AudioDriver::~PS4AudioDriver() {
+  std::lock_guard<std::mutex> guard(frames_mutex_);
+  while (!frames_unused_.empty()) {
+    delete[] frames_unused_.top();
+    frames_unused_.pop();
+  }
+  while (!frames_queued_.empty()) {
+    delete[] frames_queued_.front();
+    frames_queued_.pop();
+  }
+}
+
+void PS4AudioDriver::SubmitFrame(uint32_t frame_ptr) {
+  const auto input_frame = memory_->TranslateVirtual<float*>(frame_ptr);
+  float* output_frame;
+  {
+    std::lock_guard<std::mutex> guard(frames_mutex_);
+    if (frames_unused_.empty()) {
+      output_frame = new float[kFrameSamples];
+    } else {
+      output_frame = frames_unused_.top();
+      frames_unused_.pop();
+    }
+  }
+  std::memcpy(output_frame, input_frame, kFrameSamples * sizeof(float));
+  std::lock_guard<std::mutex> guard(frames_mutex_);
+  frames_queued_.push(output_frame);
+}
+
+bool PS4AudioDriver::MixFrameInto(float* stereo_out, const StereoFold& fold, float gain) {
+  float* frame;
+  {
+    std::lock_guard<std::mutex> guard(frames_mutex_);
+    if (frames_queued_.empty()) {
+      return false;
+    }
+    frame = frames_queued_.front();
+    frames_queued_.pop();
+  }
+  std::array<float, kChannelSamples * 2> folded;
+  conversion::sequential_6_BE_to_interleaved_2_LE(folded.data(), frame, kChannelSamples, fold,
+                                                  gain);
+  for (size_t i = 0; i < folded.size(); ++i) {
+    stereo_out[i] += folded[i];
+  }
+  std::lock_guard<std::mutex> guard(frames_mutex_);
+  frames_unused_.push(frame);
+  return true;
+}
+
+size_t PS4AudioDriver::QueuedFrames() {
+  std::lock_guard<std::mutex> guard(frames_mutex_);
+  return frames_queued_.size();
+}
+
+void PS4AudioDriver::RequestFrame() { semaphore_->Release(1, nullptr); }
+
+std::unique_ptr<AudioSystem> PS4AudioSystem::Create(
+    runtime::FunctionDispatcher* function_dispatcher) {
+  return std::make_unique<PS4AudioSystem>(function_dispatcher);
+}
+
+PS4AudioSystem::PS4AudioSystem(runtime::FunctionDispatcher* function_dispatcher)
+    : AudioSystem(function_dispatcher) {}
+
+PS4AudioSystem::~PS4AudioSystem() { StopOutput(); }
+
+X_STATUS PS4AudioSystem::CreateDriver([[maybe_unused]] size_t index,
+                                      rex::thread::Semaphore* semaphore,
+                                      AudioDriver** out_driver) {
+  assert_not_null(out_driver);
+  if (!running_ && !StartOutput()) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  auto driver = new PS4AudioDriver(memory_, semaphore);
+  {
+    std::lock_guard<std::mutex> guard(drivers_mutex_);
+    drivers_.push_back(driver);
+  }
+  *out_driver = driver;
+  return X_STATUS_SUCCESS;
+}
+
+void PS4AudioSystem::DestroyDriver(AudioDriver* driver) {
+  assert_not_null(driver);
+  auto ps4_driver = static_cast<PS4AudioDriver*>(driver);
+  {
+    std::lock_guard<std::mutex> guard(drivers_mutex_);
+    drivers_.erase(std::remove(drivers_.begin(), drivers_.end(), ps4_driver), drivers_.end());
+  }
+  delete ps4_driver;
+}
+
+bool PS4AudioSystem::StartOutput() {
+  const int32_t init = sceAudioOutInit();
+  if (init != 0 && static_cast<uint32_t>(init) != kAlreadyInitialized) {
+    REXAPU_ERROR("PS4 audio: sceAudioOutInit failed: {:08X}", static_cast<uint32_t>(init));
+    return false;
+  }
+  port_ = sceAudioOutOpen(kSystemUser, kPortTypeMain, 0, PS4AudioDriver::kChannelSamples, 48000,
+                          kFormatFloatStereo);
+  if (port_ < 0) {
+    REXAPU_ERROR("PS4 audio: sceAudioOutOpen failed: {:08X}", static_cast<uint32_t>(port_));
+    port_ = -1;
+    return false;
+  }
+  int32_t volume[2] = {32768, 32768};  // 0 dB
+  sceAudioOutSetVolume(port_, 0x3, volume);
+  running_ = true;
+  thread_ = std::thread([this]() { OutputThreadMain(); });
+  REXAPU_INFO("PS4 audio: port {} open, 48000 Hz float stereo, {} samples a buffer", port_,
+              PS4AudioDriver::kChannelSamples);
+  return true;
+}
+
+void PS4AudioSystem::StopOutput() {
+  if (!running_.exchange(false)) {
+    return;
+  }
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+  if (port_ >= 0) {
+    sceAudioOutOutput(port_, nullptr);  // waits for the last buffer
+    sceAudioOutClose(port_);
+    port_ = -1;
+  }
+}
+
+void PS4AudioSystem::OutputThreadMain() {
+  pthread_set_name_np(pthread_self(), "PS4 audio out");
+  const size_t target = static_cast<size_t>(
+      std::clamp(REXCVAR_GET(audio_ps4_frames_in_queue), 2, int32_t(kMaximumQueuedFrames)));
+  alignas(64) std::array<float, PS4AudioDriver::kChannelSamples * 2> mix;
+  while (running_.load(std::memory_order_relaxed)) {
+    mix.fill(0.0f);
+    const StereoFold fold = GetStereoFold();
+    const float gain = GetOutputGain();
+    {
+      std::lock_guard<std::mutex> guard(drivers_mutex_);
+      for (PS4AudioDriver* driver : drivers_) {
+        const size_t queued = driver->QueuedFrames();
+        if (queued < target) driver->RequestFrame();
+        if (queued < kMinQueuedFrames) driver->RequestFrame();
+        driver->MixFrameInto(mix.data(), fold, gain);
+      }
+    }
+    if (REXCVAR_GET(audio_mute)) {
+      mix.fill(0.0f);
+    }
+    const int32_t r = sceAudioOutOutput(port_, mix.data());
+    if (r < 0) {
+      REXAPU_ERROR("PS4 audio: sceAudioOutOutput failed: {:08X}; output stopped",
+                   static_cast<uint32_t>(r));
+      running_ = false;
+    }
+  }
+}
+
+}  // namespace rex::audio::ps4
