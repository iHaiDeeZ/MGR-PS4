+/*
+ * mgr-ps4 (2026-11-04, the user: "check if any cutscene was blocked in the middle"): the movies (*.usm, CRI Sofdec)
+ * the game streams, each with how far its reads got. A movie read to (about) its end played to its end; one whose
+ * reads stop early was skipped or cut short. A line when it opens, and one when its reads stop (nothing read from it
+ * for kMovieQuietUs, seen at the next file access) or another movie opens.
+ */
+constexpr uint64_t kMovieQuietUs = 3'000'000;
+
+struct MovieTrack {
+  std::string path;
+  uint64_t size = 0;
+  uint64_t furthest = 0;  // the end of the furthest read
+  uint64_t bytes = 0;
+  uint64_t opened_us = 0;
+  uint64_t last_read_us = 0;
+};
+std::mutex g_movies_mutex;
+std::vector<MovieTrack> g_movies;  // being read (one or two at a time)
+
+bool IsMovie(const std::string_view path) {
+  if (path.size() < 4) return false;
+  const std::string_view ext = path.substr(path.size() - 4);
+  return (ext[0] == '.') && (ext[1] | 0x20) == 'u' && (ext[2] | 0x20) == 's' && (ext[3] | 0x20) == 'm';
+}
+
+void ReportMovieEnd(const MovieTrack& m, uint64_t now_us, const char* why) {
+  REXKRNL_INFO("[movie] {}: {}; read up to {:.1f} of {:.1f} MB ({:.0f} %, {:.1f} MB in all) over {:.1f} s", m.path,
+               why, m.furthest / (1024.0 * 1024.0), m.size / (1024.0 * 1024.0),
+               m.size ? 100.0 * double(m.furthest) / double(m.size) : 0.0, m.bytes / (1024.0 * 1024.0),
+               (m.last_read_us - m.opened_us) / 1e6);
+  (void)now_us;
+}
+
+void NoteMovieOpened(const std::string_view path, uint64_t size, uint64_t now_us) {
+  if (!IsMovie(path)) return;
+  std::lock_guard<std::mutex> lock(g_movies_mutex);
+  for (auto it = g_movies.begin(); it != g_movies.end();) {
+    if (it->path == path) {
+      ReportMovieEnd(*it, now_us, "opened again");
+      it = g_movies.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  MovieTrack m;
+  m.path = std::string(path);
+  m.size = size;
+  m.opened_us = m.last_read_us = now_us;
+  g_movies.push_back(std::move(m));
+  REXKRNL_INFO("[movie] {}: opened ({:.1f} MB)", path, size / (1024.0 * 1024.0));
+}
+
+void NoteMovieRead(const std::string_view path, uint64_t displacement, uint32_t bytes, uint64_t now_us) {
+  std::lock_guard<std::mutex> lock(g_movies_mutex);
+  if (g_movies.empty()) return;
+  for (auto it = g_movies.begin(); it != g_movies.end();) {
+    if (it->path == path) {
+      it->furthest = std::max(it->furthest, displacement + bytes);
+      it->bytes += bytes;
+      it->last_read_us = now_us;
+      ++it;
+    } else if (now_us - it->last_read_us > kMovieQuietUs) {
+      ReportMovieEnd(*it, now_us,
+                     it->size && it->furthest + it->size / 50 >= it->size ? "reads ended (played to its end)"
+                                                                         : "reads STOPPED before its end");
+      it = g_movies.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
