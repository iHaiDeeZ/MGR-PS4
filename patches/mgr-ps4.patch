+  return __builtin_ia32_rdtsc();
 #else
   timespec tp;
   int error = clock_gettime(CLOCK_MONOTONIC_RAW, &tp);
diff --git a/sdk/src/core/dynlib_ps4.cpp b/sdk/src/core/dynlib_ps4.cpp
