+extern "C" uint64_t rex_ps4_tsc_frequency(void) __asm__("sceKernelGetTscFrequency");
+#endif
+
 #if REX_PLATFORM_SWITCH
 // Only the counter header: switch.h drags typedefs (Thread, Mutex, Event) that
 // collide with rex::thread.
@@ -42,6 +47,12 @@ uint64_t Clock::host_tick_frequency_platform() {
   // would make guest time run 52 times slower. The system counter is exact and
   // a single register read.
   return armGetSystemTickFreq();
+#elif REX_PLATFORM_PS4
+  // mgr-ps4 (2026-11-04, MGR v00.08 "too fast like speed hacks", cutscenes stalling): the TSC, as ps4-kit's
+  // clock_gettime(CLOCK_MONOTONIC). Not the formula below: the PS4's kernel answers clock_getres with FreeBSD's
+  // "1e9 / timecounter frequency + 1" (2 ns for a timecounter of 0.5-1 GHz) while clock_gettime counts nanoseconds,
+  // so every guest clock ran at a multiple of real time. One counter read, no system call.
