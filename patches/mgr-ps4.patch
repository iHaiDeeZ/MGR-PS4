+// Metal Gear Rising on the PS4: the frame counter and the L3+R3 quick menu (mgr_ps4_menu.cpp).
+#pragma once
+
+#include <filesystem>
+#include <memory>
+
+#include <rex/ui/imgui_dialog.h>
+
+namespace mgr::ps4 {
+
+// The dialog for the whole session; the menu saves its settings to 'config' (mgr.toml) when it closes.
+std::unique_ptr<rex::ui::ImGuiDialog> CreateQuickMenu(rex::ui::ImGuiDrawer* drawer, std::filesystem::path config);
+
+}  // namespace mgr::ps4
